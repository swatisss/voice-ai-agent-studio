# Copy to .env and fill in. Spec: /build/runbook-local.md
GROQ_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# DATABASE_URL=sqlite+aiosqlite:///./data/voiceai.db
# EMBEDDINGS_PROVIDER=fastembed        # or hash (offline, lower quality)
# LLM_ROLE_REALTIME=openrouter:openai/gpt-oss-120b
# Use OpenAI for every role (e.g. when Groq's free tier is rate-limited); confirm the model IDs in the OpenAI console:
# LLM_ROLE_REALTIME=openai:gpt-4.1-mini
# LLM_ROLE_ANALYSIS=openai:gpt-4.1-mini
# LLM_ROLE_DRAFTING=openai:gpt-4.1-mini
# LLM_ROLE_JUDGE=openai:gpt-4.1-mini
# LLM_ROLE_SIMULATOR=openai:gpt-4.1-nano
# LLM_ROLE_TURN=openai:gpt-4.1-nano
# AUTO_SEED=1
# JOBS_ENABLED=1
# CORS_ORIGINS=http://localhost:3000

# Video calls (optional). Without these, a video call is created as a voice call and says why.
# A vision-capable model is also needed -- OPENAI_API_KEY by default (/architecture/visual-intake.md).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# A talking face for the agent on video calls (optional). Without these the call has no face and shows a
# placeholder tile for the agent (/architecture/avatar.md). SIMLI_FACE_ID is a stock face from your Simli account.
SIMLI_API_KEY=
SIMLI_FACE_ID=
# How many avatar sessions this process may hold at once. Keep it at or below your Simli plan's limit;
# calls over it are ordinary video calls with a placeholder tile.
AVATAR_MAX_SESSIONS=1
