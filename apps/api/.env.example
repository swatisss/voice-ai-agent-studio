# Copy to .env and fill in. Spec: /build/runbook-local.md
GROQ_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=            # also needed by realtime agents (the Insurance Claims Agent)
TENANT_SECRETS_KEY=        # encrypts business units' own OpenAI keys (Settings page); scripts/setup.py fills it in

# Phone calls (Spec: /build/runbook-phone.md). PUBLIC_BASE_URL must equal the URL Twilio calls: your tunnel URL locally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=            # set by `python scripts/phone_demo.py` from the tunnel; fill in only for manual setups

# Public API, supervisor routing and WebRTC (Spec: /api/public-api.md, /architecture/supervisor-routing.md)
PUBLIC_API_SECRET=          # signs voice connect tokens; scripts/setup.py fills it in
# Decision model (optional, any Jev-compatible server). Unset = the embedding routes. Then pick "Decision model" in Settings.
# DECISION_MODEL_URL=https://api.typesafe.ai
# DECISION_MODEL_API_KEY=
# DECISION_MODEL_NAME=jev-latest
# DECISION_MODEL_THRESHOLD=0.55
# DECISION_MODEL_HOSTED=1     # a hosted model is never called while PHI_MODE is on
# DECISION_MODEL_TIMEOUT_VOICE_MS=1000   # default 350; ~1000 lets a hosted model (~550 ms) decide voice calls
# DECISION_MODEL_TIMEOUT_TEXT_MS=1500
# PHI_MODE=0                  # on by default on Cloud Run
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URLS=           # required for WebRTC on Cloud Run (no inbound UDP)

# One-command phone demo (Spec: /build/phone-demo.md): python scripts/phone_demo.py
TWILIO_PHONE_NUMBER=        # your Twilio number, e.g. +15551234567
# DEMO_AGENT=Insurance Claims Agent
# DEMO_TRANSFER_TO=+15557654321   # where a hand-off redirects the call
# NGROK_AUTHTOKEN=

# Optional overrides
# DATABASE_URL=sqlite+aiosqlite:///./data/voiceai.db
# EMBEDDINGS_PROVIDER=fastembed        # or hash (offline, lower quality)
# LLM_ROLE_REALTIME=openrouter:openai/gpt-oss-120b
# Use OpenAI for every role (e.g. when Groq's free tier is rate-limited); confirm the model IDs in the OpenAI console:
# LLM_ROLE_REALTIME=openai:gpt-4.1-mini
# LLM_ROLE_ANALYSIS=openai:gpt-4.1-mini
# LLM_ROLE_DRAFTING=openai:gpt-4.1-mini
# LLM_ROLE_JUDGE=openai:gpt-4.1-mini
# LLM_ROLE_SIMULATOR=openai:gpt-4.1-nano
# LLM_ROLE_TURN=openai:gpt-4.1-nano
# AUTO_SEED=1
# JOBS_ENABLED=1
# CORS_ORIGINS=http://localhost:3000
# TWILIO_VALIDATE_SIGNATURE=0           # local experiments only; refused on Cloud Run
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime   # realtime pipeline endpoint (tests and proxies)
# LLM_ROLE_SPEECH=openai:gpt-realtime-2.1                # speech-to-speech model; confirm the ID in the OpenAI console
